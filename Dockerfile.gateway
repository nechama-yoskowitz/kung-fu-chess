# ── Kung-Fu Chess HTTP API Gateway ──────────────────────────────────────────
# Separate image from the WebSocket Game Server so it can be scaled
# independently.  Shares the same requirements.txt (aiohttp is the only
# addition over the game-server image).

FROM python:3.12-slim

LABEL maintainer="kungfu-chess"
LABEL description="Kung-Fu Chess HTTP API Gateway"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# ── System dependencies ───────────────────────────────────────────────────────
# libpq5 required by psycopg[binary] at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ───────────────────────────────────────────────────────
COPY requirements.txt .
RUN pip install --no-cache-dir \
        --trusted-host pypi.org \
        --trusted-host pypi.python.org \
        --trusted-host files.pythonhosted.org \
        -r requirements.txt

# ── Application source ────────────────────────────────────────────────────────
COPY game/ ./game/

# ── Runtime configuration defaults ───────────────────────────────────────────
ENV KFC_DB_BACKEND=postgres \
    KFC_HTTP_HOST=0.0.0.0 \
    KFC_HTTP_PORT=8080 \
    KFC_LOG_LEVEL=INFO

# ── Health check ─────────────────────────────────────────────────────────────
# curl is not available in slim; use wget (also not present) so we rely
# on a Python one-liner that hits /health and checks the status code.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c \
        "import urllib.request, sys; \
         r = urllib.request.urlopen('http://localhost:${KFC_HTTP_PORT:-8080}/health', timeout=4); \
         sys.exit(0 if r.status == 200 else 1)" \
        2>/dev/null || exit 1

EXPOSE 8080

CMD ["python", "-m", "game.gateway"]
